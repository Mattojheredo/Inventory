}

.main-content .card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-height: 140px;
  padding: 24px;
  background-color: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05);
}

.main-content .card-label {
  font-size: 0.9rem;
  font-weight: 500;
