}

.main-content .card-value {
  flex: 1;
  font-size: 2rem;
  font-weight: 600;
  color: var(--text);
}

/* ---------- Sidebar ---------- */
.wrapper .sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: 250px;
  height: 100%;
  padding: 12px;
  background-color: var(--sidebar);
  overflow-x: hidden;
  overflow-y: auto;
  transition: width 0.2s;
}

#toggle {
  background: none;
  border: none;
  border-radius: 8px;
  color: #fff;
  cursor: pointer;
  padding: 10px 12px;
  transition: background-color 0.2s;
}

#toggle:hover {
  background-color: rgba(255, 255, 255, 0.08);
}

.wrapper .sidebar .brand-name {
  padding: 0 12px;
  margin: 8px 0 20px;
}

.wrapper .sidebar .brand-name a {
  color: #fff;
  font-size: 1.1rem;
  font-weight: 600;
}

