.wrapper .sidebar ul li a.active,
.sidebar summary.active {
  background-color: var(--accent);
  color: #fff;
}

.wrapper .sidebar a:focus-visible,
.sidebar summary:focus-visible,
#toggle:focus-visible {
  outline: 2px solid #9AD8B8;
  outline-offset: 2px;
}

/* ---------- Dropdowns (details / summary) ---------- */
.sidebar summary .arrow {
  margin-left: auto;
  transition: transform 0.2s;
}

.sidebar details[open] > summary .arrow {
  transform: rotate(-90deg);
}

.sidebar .submenu {
  margin: 4px 0 4px 22px;
  border-left: 1px solid rgba(255, 255, 255, 0.15);
}

.wrapper .sidebar .submenu li a {
  padding-left: 14px;
}

.sidebar .dot {
  display: none;
}

